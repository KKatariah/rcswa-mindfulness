# Copy to .env beside docker-compose.yml and fill in. Never commit the real .env.
# DJANGO_DEBUG, BEHIND_PROXY and the /data paths are set by docker-compose.yml.

# ── Required ──────────────────────────────────────────────────────────────────
# Long random string. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Public hostname(s) of the site, comma-separated. Keep localhost: the health check uses it.
ALLOWED_HOSTS=mindfulness.example.org,localhost
# Full origin(s) with protocol, needed for logins and the admin site over HTTPS.
CSRF_TRUSTED_ORIGINS=https://mindfulness.example.org
# True once the site is served over HTTPS (cookies are then never sent over plain HTTP).
SECURE_COOKIES=True

# ── Google sign-in ────────────────────────────────────────────────────────────
# The OAuth client ID (public, not a secret). The frontend's copy is baked in when
# the image is built, from the NEXT_PUBLIC_GOOGLE_CLIENT_ID GitHub repository variable.
GOOGLE_CLIENT_ID=

# ── Push notifications ────────────────────────────────────────────────────────
# Keypair from README.md "Push Notification Setup" §1. Empty disables push.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_ADMIN_EMAIL=

# ── Optional ──────────────────────────────────────────────────────────────────
# Port the app listens on, for the server's own HTTPS proxy to forward to.
HTTP_PORT=8080
# INFO by default; WARNING for quieter logs.
LOG_LEVEL=INFO
# Error reporting to Sentry; nothing is sent while empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# gunicorn worker processes.
GUNICORN_WORKERS=3
# How often (seconds) to check GHCR for a new release.
UPDATE_POLL_SECONDS=300
# Run a specific release instead of the newest, e.g. sha-1a2b3c4 (DEPLOYMENT.md "Rolling back").
IMAGE_TAG=latest
