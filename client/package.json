{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test:e2e:android": "E2E_DEVICE=android playwright test",
    "test:e2e:ios": "E2E_DEVICE=ios playwright test",
    "test:e2e:all": "sh -c 'status=0; for d in desktop android ios; do E2E_DEVICE=$d playwright test || status=1; done; exit $status'"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/typography": "^0.5.20",
    "next": "^16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.10.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
